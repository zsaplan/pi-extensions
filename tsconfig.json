{
  "extends": "gts/tsconfig-google.json",
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "codex-research/src/**/*.ts",
    "codex-research/test/**/*.test.ts",
    "discord-notify/src/**/*.ts",
    "discord-notify/test/**/*.ts",
    "jira/src/**/*.ts",
    "jira/test/**/*.ts",
    "polish-solution/src/**/*.ts",
    "polish-solution/test/**/*.ts",
    "profile-subagent/src/**/*.ts",
    "profile-subagent/test/**/*.ts",
    "pr-worktree-status/src/**/*.ts",
    "pr-worktree-status/test/**/*.test.ts",
    "response-review/src/**/*.ts",
    "response-review/test/**/*.test.ts",
    "session-file-footer/src/**/*.ts",
    "session-file-footer/test/**/*.test.ts",
    "response-review/web/**/*.ts",
    "response-review/knip.config.ts"
  ],
  "exclude": [
    "node_modules/**",
    "bc-zendesk/**",
    "rain-core/**",
    "raincatcher/**",
    "raindistiller/**",
    "rainman/**",
    "response-review/web/**/*.js",
    "polish-solution/tmp/**",
    "profile-subagent/tmp/**",
    "response-review/tmp/**",
    "src/**",
    "tmp/**"
  ]
}
