{
  "name": "@zsaplan/pi-extensions",
  "version": "0.1.1",
  "description": "Personal repo-backed source for pi extensions.",
  "type": "module",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zsaplan/pi-extensions.git"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "rain"
  ],
  "scripts": {
    "lint": "gts lint",
    "fix": "gts fix && npm run prepare:packages",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "verify:packages": "npm run verify --workspaces --if-present",
    "prepare:packages": "npm run prepare --workspaces --if-present",
    "verify": "npm run lint && npm run verify:packages && npm run verify:live-config",
    "verify:upgrade": "node scripts/verify-pi-upgrade.mjs",
    "verify:live": "node scripts/verify-pi-live.mjs",
    "verify:live-config": "eslint scripts/live-config.mjs scripts/live-config.test.mjs scripts/verify-pi-live.mjs && node --test scripts/live-config.test.mjs",
    "prepare": "npm run prepare:packages"
  },
  "files": [
    "discord-notify",
    "jira",
    "polish-solution",
    "pr-worktree-status",
    "rain-core",
    "raincatcher",
    "raindistiller",
    "rainman",
    "response-review",
    "session-file-footer",
    "DESIGN.md",
    "README.md",
    "package.json"
  ],
  "pi": {
    "extensions": [
      "./discord-notify/src/index.ts",
      "./jira/src/index.ts",
      "./polish-solution/src/index.ts",
      "./pr-worktree-status/src/index.ts",
      "./raincatcher/src/index.ts",
      "./raindistiller/src/index.ts",
      "./rainman/src/index.ts",
      "./response-review/src/index.ts",
      "./session-file-footer/src/index.ts"
    ],
    "skills": [
      "./polish-solution/skills"
    ]
  },
  "dependencies": {
    "@zsaplan/rain-core": "file:./rain-core",
    "glimpseui": "^0.6.0",
    "typebox": "^1.1.24"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.87.1",
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@earendil-works/pi-tui": "0.87.1",
    "@types/node": "^24.12.2",
    "gts": "^7.0.0",
    "knip": "^5.88.1",
    "typescript": "^5.9.3"
  },
  "workspaces": [
    "discord-notify",
    "jira",
    "polish-solution",
    "pr-worktree-status",
    "rain-core",
    "raincatcher",
    "raindistiller",
    "rainman",
    "response-review",
    "session-file-footer"
  ]
}
