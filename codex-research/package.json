{
  "name": "@zsaplan/pi-codex-research",
  "version": "0.1.0",
  "description": "Pi extension that delegates isolated, cited web research to the authenticated Codex CLI.",
  "type": "module",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zsaplan/pi-extensions.git",
    "directory": "codex-research"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "codex",
    "research",
    "web-search"
  ],
  "files": [
    "src",
    "DESIGN.md",
    "README.md",
    "package.json"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "scripts": {
    "lint": "gts lint",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.ts",
    "verify": "npm run lint && npm run typecheck && npm run test"
  },
  "devDependencies": {
    "@types/node": "^24.12.2",
    "gts": "^7.0.0",
    "typebox": "^1.1.24",
    "typescript": "^5.9.3"
  }
}
